    "deploy:commands": "tsx src/deploy-commands.ts",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "discord.js": "^14.26.0",
    "dotenv": "^17.4.0",
    "openai": "^6.45.0",
    "tiktoken": "^1.0.22",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "latest",
    "prisma": "^6.19.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
